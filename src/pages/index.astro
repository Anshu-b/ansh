---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import { SITE, SOCIALS } from "@consts"
import { PROFILE, BIO, ORGANIZATIONS, COURSEWORK } from "@data/about"
import { workEntries } from "@data/work"

const projects = (await getCollection("projects"))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
---

<PageLayout title="About" description={SITE.DESCRIPTION} theme="notebook" notebookFile="about.ipynb">

  <div class="nb-page">

    <!-- Markdown cell: hero -->
    <div class="nb-cell">
      <div class="nb-gutter"></div>
      <div class="nb-md">
        <h1>Ansh Bhatnagar</h1>
        <p><em>data science · cognitive science · math-cs · uc san diego</em></p>
      </div>
    </div>

    <div class="nb-spacer-sm"></div>

    <!-- ── CELL 1: about() ────────────────────────────────────── -->
    <div class="nb-cell nb-runnable" data-cell-id="1" id="cell-1">
      <div class="nb-gutter" id="gutter-1">In&nbsp;[&nbsp;]:</div>
      <div class="nb-code">
        <button class="nb-run-btn" aria-label="Run cell">▶</button>
        <span class="nb-kw">import</span> <span class="nb-mod">ansh_bhatnagar</span> <span class="nb-kw">as</span> <span class="nb-mod">ansh</span><br/>
        <span class="nb-cm"># load profile</span><br/>
        ansh.<span class="nb-fn">about</span>()
      </div>
    </div>

    <div class="nb-cell" id="output-1">
      <div class="nb-gutter nb-gutter-out" id="out-gutter-1">
        <span id="out-prompt-1">Out[&nbsp;]:</span>
        <button class="nb-toggle-btn" data-target="out-content-1" aria-label="Toggle output">▶</button>
      </div>
      <div class="nb-output nb-hidden" id="out-content-1">
        <div class="nb-out-dict">
          <span class="nb-out-punc">{'{'}</span>
          {PROFILE.map((item) => (
            <div class="about-dict-row">
              <span class="nb-out-dict-key">&nbsp;&nbsp;'{item.key}'</span>
              <span class="nb-out-dict-punc">:</span>
              <span class="nb-out-dict-str">&nbsp;'{item.value}',</span>
            </div>
          ))}
          <span class="nb-out-punc">{'}'}</span>
        </div>
        <p class="about-bio">{BIO}</p>
      </div>
    </div>

    <div class="nb-spacer"></div>

    <!-- ── CELL 2: organizations() ───────────────────────────── -->
    <div class="nb-cell">
      <div class="nb-gutter"></div>
      <div class="nb-md"><h2>§ Organizations</h2></div>
    </div>

    <div class="nb-cell nb-runnable" data-cell-id="2" id="cell-2">
      <div class="nb-gutter" id="gutter-2">In&nbsp;[&nbsp;]:</div>
      <div class="nb-code">
        <button class="nb-run-btn" aria-label="Run cell">▶</button>
        ansh.<span class="nb-fn">organizations</span>()
      </div>
    </div>

    <div class="nb-cell" id="output-2">
      <div class="nb-gutter nb-gutter-out" id="out-gutter-2">
        <span id="out-prompt-2">Out[&nbsp;]:</span>
        <button class="nb-toggle-btn" data-target="out-content-2" aria-label="Toggle output">▶</button>
      </div>
      <div class="nb-output nb-hidden" id="out-content-2">
        <table class="nb-out-table">
          <thead>
            <tr><th>organization</th><th>role</th><th>description</th></tr>
          </thead>
          <tbody>
            {ORGANIZATIONS.map((org) => (
              <tr>
                <td>{org.name}</td>
                <td>{org.role}</td>
                <td class="about-dim">{org.description}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="nb-spacer"></div>

    <!-- ── CELL 3: deployments() ────────────────────────────── -->
    <div class="nb-cell">
      <div class="nb-gutter"></div>
      <div class="nb-md"><h2>§ Experience</h2></div>
    </div>

    <div class="nb-cell nb-runnable" data-cell-id="3" id="cell-3">
      <div class="nb-gutter" id="gutter-3">In&nbsp;[&nbsp;]:</div>
      <div class="nb-code">
        <button class="nb-run-btn" aria-label="Run cell">▶</button>
        <span class="nb-cm"># {workEntries.length} roles</span><br/>
        ansh.<span class="nb-fn">experience</span>()
      </div>
    </div>

    <div class="nb-cell" id="output-3">
      <div class="nb-gutter nb-gutter-out" id="out-gutter-3">
        <span id="out-prompt-3">Out[&nbsp;]:</span>
        <button class="nb-toggle-btn" data-target="out-content-3" aria-label="Toggle output">▶</button>
      </div>
      <div class="nb-output nb-hidden" id="out-content-3">
        <table class="nb-out-table">
          <thead>
            <tr><th>company</th><th>role</th><th>location</th></tr>
          </thead>
          <tbody>
            {workEntries.map((e) => (
              <tr>
                <td>{e.company}</td>
                <td>{e.role}</td>
                <td class="about-dim">{e.location}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="nb-spacer"></div>

    <!-- ── CELL 4: projects() ───────────────────────────────── -->
    <div class="nb-cell">
      <div class="nb-gutter"></div>
      <div class="nb-md"><h2>§ Projects</h2></div>
    </div>

    <div class="nb-cell nb-runnable" data-cell-id="4" id="cell-4">
      <div class="nb-gutter" id="gutter-4">In&nbsp;[&nbsp;]:</div>
      <div class="nb-code">
        <button class="nb-run-btn" aria-label="Run cell">▶</button>
        <span class="nb-cm"># {projects.length} published</span><br/>
        ansh.<span class="nb-fn">projects</span>()
      </div>
    </div>

    <div class="nb-cell" id="output-4">
      <div class="nb-gutter nb-gutter-out" id="out-gutter-4">
        <span id="out-prompt-4">Out[&nbsp;]:</span>
        <button class="nb-toggle-btn" data-target="out-content-4" aria-label="Toggle output">▶</button>
      </div>
      <div class="nb-output nb-hidden" id="out-content-4">
        <table class="nb-out-table">
          <thead>
            <tr><th>title</th><th>summary</th></tr>
          </thead>
          <tbody>
            {projects.map((p) => (
              <tr>
                <td>
                  {(p.data.demoUrl || p.data.repoUrl) ? (
                    <a href={p.data.demoUrl || p.data.repoUrl} target="_blank" rel="noopener noreferrer" class="about-proj-link">
                      {p.data.title}
                    </a>
                  ) : p.data.title}
                </td>
                <td class="about-dim">{p.data.summary}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="nb-spacer"></div>

    <!-- ── CELL 5: coursework() ──────────────────────────────── -->
    <div class="nb-cell">
      <div class="nb-gutter"></div>
      <div class="nb-md"><h2>§ Coursework</h2></div>
    </div>

    <div class="nb-cell nb-runnable" data-cell-id="5" id="cell-5">
      <div class="nb-gutter" id="gutter-5">In&nbsp;[&nbsp;]:</div>
      <div class="nb-code">
        <button class="nb-run-btn" aria-label="Run cell">▶</button>
        ansh.<span class="nb-fn">coursework</span>()
      </div>
    </div>

    <div class="nb-cell" id="output-5">
      <div class="nb-gutter nb-gutter-out" id="out-gutter-5">
        <span id="out-prompt-5">Out[&nbsp;]:</span>
        <button class="nb-toggle-btn" data-target="out-content-5" aria-label="Toggle output">▶</button>
      </div>
      <div class="nb-output nb-hidden" id="out-content-5">
        <div class="about-coursework">
          Coursework that changed how I think:
          {COURSEWORK.map((c) => (
            <div class="about-course-row">
              <span class="nb-out-blue about-course-code">{c.code}</span>
              <span class="about-course-desc">{c.description}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="nb-spacer"></div>

    <!-- ── CELL 6: contact() ─────────────────────────────────── -->
    <div class="nb-cell">
      <div class="nb-gutter"></div>
      <div class="nb-md"><h2>§ Contact</h2></div>
    </div>

    <div class="nb-cell nb-runnable" data-cell-id="6" id="cell-6">
      <div class="nb-gutter" id="gutter-6">In&nbsp;[&nbsp;]:</div>
      <div class="nb-code">
        <button class="nb-run-btn" aria-label="Run cell">▶</button>
        ansh.<span class="nb-fn">contact</span>()
      </div>
    </div>

    <div class="nb-cell" id="output-6">
      <div class="nb-gutter nb-gutter-out" id="out-gutter-6">
        <span id="out-prompt-6">Out[&nbsp;]:</span>
        <button class="nb-toggle-btn" data-target="out-content-6" aria-label="Toggle output">▶</button>
      </div>
      <div class="nb-output nb-hidden" id="out-content-6">
        <div class="nb-out-dict">
          <span class="nb-out-punc">{'{'}</span>
          {SOCIALS.map((social) => (
            <div>
              &nbsp;&nbsp;<a href={social.HREF} target="_blank" rel="noopener noreferrer" class="nb-contact-entry">
                <span class="nb-out-dict-key">'{social.NAME}'</span>
                <span class="nb-out-dict-punc">:&nbsp;</span>
                <span class="nb-out-dict-str">'{social.TEXT}'</span>
              </a>
            </div>
          ))}
          <span class="nb-out-punc">{'}'}</span>
        </div>
        <div class="about-nav-links">
          <a href="/ansh/blog" class="about-nav-btn">open blog.ipynb →</a>
          <a href="/ansh/work" class="about-nav-btn about-nav-btn-outline">open work.ipynb →</a>
          <a href="/ansh/projects" class="about-nav-btn about-nav-btn-outline">open projects.ipynb →</a>
        </div>
      </div>
    </div>

    <div class="nb-spacer"></div>

  </div>

</PageLayout>

<style>
  .nb-out-punc { color: #8b949e; }

  /* Profile dict rows: key aligned in a fixed-width column */
  .about-dict-row {
    display: grid;
    grid-template-columns: 13ch max-content 1fr;
    line-height: 1.9;
  }

  .about-bio {
    margin-top: 0.75rem;
    font-family: 'Atkinson', sans-serif;
    font-size: 0.88rem;
    line-height: 1.75;
    color: rgba(201, 209, 217, 0.7);
    white-space: normal;
  }

  /* Muted description column in orgs table */
  .about-dim {
    color: rgba(230, 237, 243, 0.6) !important;
    white-space: normal !important;
    font-size: 0.74rem;
  }

  /* Coursework */
  .about-coursework {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.79rem;
  }
  .about-course-heading {
    margin-bottom: 0.4rem;
  }
  .about-course-row {
    display: grid;
    grid-template-columns: 10ch 1fr;
    gap: 0.5rem;
    line-height: 1.85;
  }
  .about-course-code { color: #79c0ff; }
  .about-course-desc { color: rgba(230, 237, 243, 0.7); }

  .about-proj-link {
    color: #79c0ff;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .about-proj-link:hover { color: #a5d6ff; }

  .nb-contact-entry {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  .nb-contact-entry:hover { opacity: 0.75; }

  .about-nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .about-nav-btn {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid rgba(63, 185, 80, 0.4);
    border-radius: 3px;
    color: #3fb950;
    background: rgba(63, 185, 80, 0.07);
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .about-nav-btn:hover {
    background: rgba(63, 185, 80, 0.15);
    border-color: rgba(63, 185, 80, 0.7);
  }

  .about-nav-btn-outline {
    background: transparent;
    color: #8b949e;
    border-color: rgba(139, 148, 158, 0.3);
  }
  .about-nav-btn-outline:hover {
    background: rgba(139, 148, 158, 0.06);
    border-color: rgba(139, 148, 158, 0.5);
    color: #e6edf3;
  }
</style>

<script is:inline>
(function () {
  var execCount = 0;

  function runCell(cellId) {
    var cell       = document.getElementById('cell-' + cellId);
    var gutter     = document.getElementById('gutter-' + cellId);
    var outPrompt  = document.getElementById('out-prompt-' + cellId);
    var outContent = document.getElementById('out-content-' + cellId);
    var outGutter  = document.getElementById('out-gutter-' + cellId);
    var toggleBtn  = outGutter ? outGutter.querySelector('.nb-toggle-btn') : null;
    var kernelDot    = document.getElementById('nb-kernel-dot');
    var kernelStatus = document.getElementById('nb-kernel-status');

    if (!outContent) return Promise.resolve();

    cell && cell.classList.add('nb-running');
    if (gutter) gutter.innerHTML = 'In\u00A0[*]:';
    kernelDot    && kernelDot.classList.add('busy');
    if (kernelStatus) kernelStatus.textContent = 'Python 3 | busy';

    return new Promise(function (resolve) {
      setTimeout(function () {
        execCount++;
        if (gutter)    gutter.innerHTML   = 'In\u00A0[' + execCount + ']:';
        if (outPrompt) outPrompt.innerHTML = 'Out[' + execCount + ']:';

        outContent.classList.remove('nb-hidden', 'nb-collapsed');
        outContent.classList.add('nb-revealed');
        outContent.style.animation = 'none';
        outContent.offsetHeight;
        outContent.style.animation = '';

        if (toggleBtn) toggleBtn.textContent = '▼';
        cell && cell.classList.remove('nb-running');
        kernelDot    && kernelDot.classList.remove('busy');
        if (kernelStatus) kernelStatus.textContent = 'Python 3 | idle';

        resolve();
      }, 320 + Math.random() * 280);
    });
  }

  function resetAll() {
    execCount = 0;
    document.querySelectorAll('.nb-output.nb-revealed').forEach(function (el) {
      el.classList.remove('nb-revealed');
      el.classList.add('nb-hidden');
    });
    for (var i = 1; i <= 6; i++) {
      var p = document.getElementById('out-prompt-' + i);
      if (p) p.innerHTML = 'Out[\u00A0]:';
      var g = document.getElementById('gutter-' + i);
      if (g) g.innerHTML = 'In\u00A0[\u00A0]:';
    }
    document.querySelectorAll('.nb-toggle-btn').forEach(function (btn) { btn.textContent = '▶'; });
  }

  async function runAll() {
    resetAll();
    var cells = document.querySelectorAll('.nb-runnable[data-cell-id]');
    for (var i = 0; i < cells.length; i++) {
      await runCell(cells[i].dataset.cellId);
      await new Promise(function (r) { setTimeout(r, 80); });
    }
  }

  document.querySelectorAll('.nb-run-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var cell = btn.closest('.nb-runnable');
      if (cell && cell.dataset.cellId) runCell(cell.dataset.cellId);
    });
  });

  document.querySelectorAll('.nb-toggle-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var target = document.getElementById(btn.dataset.target);
      if (!target) return;
      var hidden = target.classList.contains('nb-hidden') || target.classList.contains('nb-collapsed');
      if (hidden) {
        target.classList.remove('nb-hidden', 'nb-collapsed');
        target.classList.add('nb-revealed');
        btn.textContent = '▼';
      } else {
        target.classList.remove('nb-revealed');
        target.classList.add('nb-collapsed');
        btn.textContent = '▶';
      }
    });
  });

  var runAllBtn = document.getElementById('nb-run-all');
  if (runAllBtn) runAllBtn.addEventListener('click', runAll);

  setTimeout(runAll, 700);
})();
</script>
