---
import PageLayout from "@layouts/PageLayout.astro"
import { SITE, SOCIALS } from "@consts"
---

<PageLayout title="About" description={SITE.DESCRIPTION} theme="notebook" notebookFile="about.ipynb">

  <div class="nb-page">

    <!-- Markdown cell: hero header -->
    <div class="nb-cell">
      <div class="nb-gutter"></div>
      <div class="nb-md">
        <h1>Ansh Bhatnagar</h1>
        <p><em>data science · cognitive science · math-cs · uc san diego</em></p>
      </div>
    </div>

    <div class="nb-spacer-sm"></div>

    <!-- Code cell 1: initialize -->
    <div class="nb-cell nb-runnable" data-cell-id="1" id="cell-1">
      <div class="nb-gutter" id="gutter-1">In&nbsp;[&nbsp;]:</div>
      <div class="nb-code">
        <button class="nb-run-btn" aria-label="Run cell">▶</button>
        <span class="nb-kw">import</span> <span class="nb-mod">ansh_bhatnagar</span> <span class="nb-kw">as</span> <span class="nb-mod">ansh</span><br/>
        <span class="nb-cm"># load profile</span><br/>
        ansh.<span class="nb-fn">about</span>()
      </div>
    </div>

    <!-- Output 1: profile -->
    <div class="nb-cell" id="output-1">
      <div class="nb-gutter nb-gutter-out" id="out-gutter-1">
        <span id="out-prompt-1">Out[&nbsp;]:</span>
        <button class="nb-toggle-btn" data-target="out-content-1" aria-label="Toggle output">▶</button>
      </div>
      <div class="nb-output nb-hidden" id="out-content-1">
        <div class="nb-out-dict">
          <span class="nb-out-punc">{</span><br/>
          &nbsp;&nbsp;<span class="nb-out-dict-key">'name'</span><span class="nb-out-dict-punc">:</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="nb-out-dict-str">'Ansh Bhatnagar'</span><span class="nb-out-dict-punc">,</span><br/>
          &nbsp;&nbsp;<span class="nb-out-dict-key">'role'</span><span class="nb-out-dict-punc">:</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="nb-out-dict-str">'SDE Intern — Amazon Web Services'</span><span class="nb-out-dict-punc">,</span><br/>
          &nbsp;&nbsp;<span class="nb-out-dict-key">'org'</span><span class="nb-out-dict-punc">:</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="nb-out-dict-str">'President @ DS3 · Founder @ AWS Cloud Club · GDG UCSD'</span><span class="nb-out-dict-punc">,</span><br/>
          &nbsp;&nbsp;<span class="nb-out-dict-key">'hackathon'</span><span class="nb-out-dict-punc">:</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="nb-out-dict-str">'Director @ DataHacks 2026 (~$100k budget, 400+ students)'</span><span class="nb-out-dict-punc">,</span><br/>
          &nbsp;&nbsp;<span class="nb-out-dict-key">'studying'</span><span class="nb-out-dict-punc">:</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="nb-out-dict-str">'Data Science, Cognitive Science, Math-CS @ UCSD'</span><span class="nb-out-dict-punc">,</span><br/>
          &nbsp;&nbsp;<span class="nb-out-dict-key">'building'</span><span class="nb-out-dict-punc">:</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="nb-out-dict-str">'things that hold up in production'</span><br/>
          <span class="nb-out-punc">}</span>
        </div>
        <div class="nb-out-stream about-bio">
          <br/>
          I like to move fast, take ownership, and build things that actually work — even if that means breaking a few things along the way.
          I'm not trying to fit into one lane: I want to understand how systems work end-to-end, from the infrastructure to the model to the real-world impact.
        </div>
      </div>
    </div>

    <div class="nb-spacer"></div>

    <!-- Markdown cell: organizations header -->
    <div class="nb-cell">
      <div class="nb-gutter"></div>
      <div class="nb-md"><h2>§ Organizations</h2></div>
    </div>

    <!-- Code cell 2: organizations -->
    <div class="nb-cell nb-runnable" data-cell-id="2" id="cell-2">
      <div class="nb-gutter" id="gutter-2">In&nbsp;[&nbsp;]:</div>
      <div class="nb-code">
        <button class="nb-run-btn" aria-label="Run cell">▶</button>
        ansh.<span class="nb-fn">organizations</span>()
      </div>
    </div>

    <!-- Output 2: org list -->
    <div class="nb-cell" id="output-2">
      <div class="nb-gutter nb-gutter-out" id="out-gutter-2">
        <span id="out-prompt-2">Out[&nbsp;]:</span>
        <button class="nb-toggle-btn" data-target="out-content-2" aria-label="Toggle output">▶</button>
      </div>
      <div class="nb-output nb-hidden" id="out-content-2">
        <table class="nb-out-table">
          <thead>
            <tr>
              <th>organization</th>
              <th>role</th>
              <th>description</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Data Science Student Society (DS3)</td>
              <td>President</td>
              <td>Scaled to 600+ members. Consulting, real-world data science, connecting students with research and industry.</td>
            </tr>
            <tr>
              <td>AWS Cloud Club @ UCSD</td>
              <td>Founder & Lead</td>
              <td>Founded and lead an industry-backed student org focused on cloud computing education.</td>
            </tr>
            <tr>
              <td>Google Developer Group (GDG) on Campus</td>
              <td>Founder & Lead</td>
              <td>Built UCSD's GDG chapter, bridging students with Google's developer ecosystem.</td>
            </tr>
            <tr>
              <td>DataHacks 2026</td>
              <td>Director</td>
              <td>400+ students, ~$100k budget. Judges from Apple, Google, NVIDIA, YCombinator, Microsoft.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="nb-spacer"></div>

    <!-- Markdown cell: experience header -->
    <div class="nb-cell">
      <div class="nb-gutter"></div>
      <div class="nb-md"><h2>§ Experience &amp; Learning</h2></div>
    </div>

    <!-- Code cell 3: deployments -->
    <div class="nb-cell nb-runnable" data-cell-id="3" id="cell-3">
      <div class="nb-gutter" id="gutter-3">In&nbsp;[&nbsp;]:</div>
      <div class="nb-code">
        <button class="nb-run-btn" aria-label="Run cell">▶</button>
        ansh.<span class="nb-fn">deployments</span>()<br/>
        ansh.<span class="nb-fn">coursework</span>()
      </div>
    </div>

    <!-- Output 3: experience + coursework -->
    <div class="nb-cell" id="output-3">
      <div class="nb-gutter nb-gutter-out" id="out-gutter-3">
        <span id="out-prompt-3">Out[&nbsp;]:</span>
        <button class="nb-toggle-btn" data-target="out-content-3" aria-label="Toggle output">▶</button>
      </div>
      <div class="nb-output nb-hidden" id="out-content-3">
        <div class="nb-out-text"><span class="nb-out-hl">Amazon Web Services</span>&nbsp;&nbsp;&nbsp;<span class="nb-out-green">SDE Intern</span>
<span class="nb-out-sep">────────────────────────────────────────────────────────────────</span>
Built an anomaly detection system for EC2 deployments at scale. Designed to operate in
production, integrate with real systems, and support engineers in high-stakes situations.
That experience pushed me to think less about "models" and more about systems that hold up.

<span class="nb-out-hl">Coursework that changed how I think:</span>
<span class="nb-out-blue">CSE 29</span>    Systems Programming — memory, processes, how software actually runs
<span class="nb-out-blue">DSC 120</span>   Signal Processing — transforms, filtering, structure from raw signals
<span class="nb-out-blue">DSC 190</span>   IoT &amp; Sensors — end-to-end systems, streaming pipelines, hardware-software
<span class="nb-out-blue">DSC 80</span>    Pandas, ML practice (140A-B: models to deployment)
<span class="nb-out-blue">COGS 181</span>  Deep Learning — neural nets, architectures, training
<span class="nb-out-blue">COGS 150</span>  Large Language Models — transformers, prompting, real applications
<span class="nb-out-blue">MATH 173A</span> Optimization — gradients, convexity, ML as optimization
<span class="nb-out-blue">MGT 175</span>   Supply Chain &amp; Operations — scale, tradeoffs, uncertainty</div>
        </div>
      </div>
    </div>

    <div class="nb-spacer"></div>

    <!-- Markdown cell: contact header -->
    <div class="nb-cell">
      <div class="nb-gutter"></div>
      <div class="nb-md"><h2>§ Contact</h2></div>
    </div>

    <!-- Code cell 4: contact -->
    <div class="nb-cell nb-runnable" data-cell-id="4" id="cell-4">
      <div class="nb-gutter" id="gutter-4">In&nbsp;[&nbsp;]:</div>
      <div class="nb-code">
        <button class="nb-run-btn" aria-label="Run cell">▶</button>
        ansh.<span class="nb-fn">contact</span>()
      </div>
    </div>

    <!-- Output 4: socials + nav -->
    <div class="nb-cell" id="output-4">
      <div class="nb-gutter nb-gutter-out" id="out-gutter-4">
        <span id="out-prompt-4">Out[&nbsp;]:</span>
        <button class="nb-toggle-btn" data-target="out-content-4" aria-label="Toggle output">▶</button>
      </div>
      <div class="nb-output nb-hidden" id="out-content-4">
        <div class="nb-out-dict">
          <span class="nb-out-punc">{'{'}</span><br/>
          {SOCIALS.map((social) => (
            <div>
              &nbsp;&nbsp;<a href={social.HREF} target="_blank" rel="noopener noreferrer" class="nb-contact-entry">
                <span class="nb-out-dict-key">'{social.NAME}'</span>
                <span class="nb-out-dict-punc">:&nbsp;&nbsp;</span>
                <span class="nb-out-dict-str">'{social.TEXT}'</span>
              </a>
            </div>
          ))}
          <span class="nb-out-punc">{'}'}</span>
        </div>
        <div class="about-nav-links">
          <a href="/ansh/blog" class="about-nav-btn">open blog.ipynb →</a>
          <a href="/ansh/work" class="about-nav-btn about-nav-btn-outline">open work.ipynb →</a>
          <a href="/ansh/projects" class="about-nav-btn about-nav-btn-outline">open projects.ipynb →</a>
        </div>
      </div>
    </div>

    <div class="nb-spacer"></div>

  </div>

</PageLayout>

<style>
  /* About output extras */
  .nb-out-punc { color: #8b949e; }

  .about-bio {
    margin-top: 0.5rem;
    color: rgba(201, 209, 217, 0.7);
    font-family: 'Atkinson', sans-serif;
    font-size: 0.9rem;
    line-height: 1.75;
    font-family: inherit;
    white-space: normal;
  }

  .nb-contact-entry {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .nb-contact-entry:hover { opacity: 0.75; }

  .about-nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .about-nav-btn {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid rgba(63, 185, 80, 0.4);
    border-radius: 3px;
    color: #3fb950;
    background: rgba(63, 185, 80, 0.07);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .about-nav-btn:hover {
    background: rgba(63, 185, 80, 0.15);
    border-color: rgba(63, 185, 80, 0.7);
  }

  .about-nav-btn-outline {
    background: transparent;
    color: #8b949e;
    border-color: rgba(139, 148, 158, 0.3);
  }

  .about-nav-btn-outline:hover {
    background: rgba(139, 148, 158, 0.06);
    border-color: rgba(139, 148, 158, 0.5);
    color: #e6edf3;
  }
</style>

<script is:inline>
(function () {
  var execCount = 0;

  function runCell(cellId) {
    var cell = document.getElementById('cell-' + cellId);
    var gutter = document.getElementById('gutter-' + cellId);
    var outPrompt = document.getElementById('out-prompt-' + cellId);
    var outContent = document.getElementById('out-content-' + cellId);
    var outGutter = document.getElementById('out-gutter-' + cellId);
    var toggleBtn = outGutter ? outGutter.querySelector('.nb-toggle-btn') : null;
    var kernelDot = document.getElementById('nb-kernel-dot');
    var kernelStatus = document.getElementById('nb-kernel-status');

    if (!outContent) return Promise.resolve();

    cell && cell.classList.add('nb-running');
    if (gutter) gutter.innerHTML = 'In\u00A0[*]:';
    kernelDot && kernelDot.classList.add('busy');
    if (kernelStatus) kernelStatus.textContent = 'Python 3 | busy';

    return new Promise(function (resolve) {
      setTimeout(function () {
        execCount++;
        if (gutter) gutter.innerHTML = 'In\u00A0[' + execCount + ']:';
        if (outPrompt) outPrompt.innerHTML = 'Out[' + execCount + ']:';

        outContent.classList.remove('nb-hidden');
        outContent.classList.remove('nb-collapsed');
        outContent.classList.add('nb-revealed');
        outContent.style.animation = 'none';
        outContent.offsetHeight; // reflow
        outContent.style.animation = '';

        if (toggleBtn) toggleBtn.textContent = '▼';

        cell && cell.classList.remove('nb-running');
        kernelDot && kernelDot.classList.remove('busy');
        if (kernelStatus) kernelStatus.textContent = 'Python 3 | idle';

        resolve();
      }, 320 + Math.random() * 280);
    });
  }

  function resetAll() {
    execCount = 0;
    document.querySelectorAll('.nb-output.nb-revealed').forEach(function (el) {
      el.classList.add('nb-hidden');
      el.classList.remove('nb-revealed');
    });
    // Reset prompts (spans inside out-gutter, not the whole gutter)
    for (var i = 1; i <= 4; i++) {
      var p = document.getElementById('out-prompt-' + i);
      if (p) p.innerHTML = 'Out[\u00A0]:';
    }
    document.querySelectorAll('.nb-runnable .nb-gutter').forEach(function (el) {
      el.innerHTML = 'In\u00A0[\u00A0]:';
    });
    document.querySelectorAll('.nb-toggle-btn').forEach(function (btn) {
      btn.textContent = '▶';
    });
  }

  async function runAll() {
    resetAll();
    var cells = document.querySelectorAll('.nb-runnable[data-cell-id]');
    for (var i = 0; i < cells.length; i++) {
      await runCell(cells[i].dataset.cellId);
      await new Promise(function (r) { setTimeout(r, 80); });
    }
  }

  // Individual run buttons
  document.querySelectorAll('.nb-run-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var cell = btn.closest('.nb-runnable');
      if (cell && cell.dataset.cellId) runCell(cell.dataset.cellId);
    });
  });

  // Toggle (hide/show) buttons
  document.querySelectorAll('.nb-toggle-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var target = document.getElementById(btn.dataset.target);
      if (!target) return;
      var hidden = target.classList.contains('nb-hidden') || target.classList.contains('nb-collapsed');
      if (hidden) {
        target.classList.remove('nb-hidden');
        target.classList.remove('nb-collapsed');
        target.classList.add('nb-revealed');
        btn.textContent = '▼';
      } else {
        target.classList.remove('nb-revealed');
        target.classList.add('nb-collapsed');
        btn.textContent = '▶';
      }
    });
  });

  // Run all button (in toolbar)
  var runAllBtn = document.getElementById('nb-run-all');
  if (runAllBtn) runAllBtn.addEventListener('click', runAll);

  // Auto-run on load
  setTimeout(runAll, 700);
})();
</script>
