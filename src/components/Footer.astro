---
import { SITE, SOCIALS } from "@consts"
import Container from "@components/Container.astro"
---

<footer class="nb-footer">
  <Container size="md">
    <div class="nb-footer-inner">
      <div class="nb-footer-left">
        <span class="nb-footer-prompt">#</span>
        <span class="nb-footer-text">Python 3 kernel |</span>
        <span class="nb-footer-idle">
          <span class="nb-footer-dot"></span>
          idle
        </span>
        <span class="nb-footer-sep">·</span>
        <button id="back-to-top" class="nb-footer-top" aria-label="Back to top of page">↑ top</button>
      </div>
      <div class="nb-footer-right">
        {SOCIALS.map((SOCIAL) => (
          <a
            href={SOCIAL.HREF}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${SITE.TITLE} on ${SOCIAL.NAME}`}
            class="nb-footer-social"
          >
            <svg class="nb-footer-icon">
              <use href={`/ansh/social.svg#${SOCIAL.ICON}`} />
            </svg>
          </a>
        ))}
      </div>
    </div>
  </Container>
</footer>

<style>
  .nb-footer {
    background: #161b22;
    border-top: 1px solid #21262d;
    padding: 0.7rem 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: #8b949e;
  }

  .nb-footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .nb-footer-left {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .nb-footer-prompt {
    color: rgba(63, 185, 80, 0.5);
  }

  .nb-footer-text {
    color: #8b949e;
  }

  .nb-footer-idle {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    color: #3fb950;
  }

  .nb-footer-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #3fb950;
    flex-shrink: 0;
  }

  .nb-footer-sep {
    color: #21262d;
  }

  .nb-footer-top {
    background: none;
    border: none;
    color: #8b949e;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    cursor: pointer;
    padding: 0;
    transition: color 0.15s ease;
  }

  .nb-footer-top:hover {
    color: #e6edf3;
  }

  .nb-footer-right {
    display: flex;
    align-items: center;
    gap: 0.1rem;
  }

  .nb-footer-social {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 3px;
    color: #8b949e;
    transition: all 0.15s ease;
    text-decoration: none;
  }

  .nb-footer-social:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #e6edf3;
  }

  .nb-footer-icon {
    width: 15px;
    height: 15px;
    fill: currentColor;
    display: block;
  }
</style>

<script is:inline>
  function goBackToTop(event) {
    event.preventDefault()
    window.scrollTo({ top: 0, behavior: "smooth" })
  }

  function initializeBackToTop() {
    const btn = document.getElementById("back-to-top")
    btn?.addEventListener("click", goBackToTop)
  }

  document.addEventListener("astro:after-swap", initializeBackToTop)
  initializeBackToTop()
</script>
