---
import { SITE, LINKS } from "@consts"
const { pathname } = Astro.url

function isActive(href: string): boolean {
  if (href === '/ansh') return pathname === '/ansh' || pathname === '/ansh/'
  return pathname === href || pathname.startsWith(href + '/')
}
---

<header id="header" class="fixed top-0 w-full h-16 z-50">
  <div class="nb-hdr-inner">

    <!-- Brand -->
    <a href="/ansh" class="nb-hdr-brand brand-link">
      <svg class="nb-hdr-brand-icon" aria-hidden="true">
        <use href="/ansh/brand.svg#brand"></use>
      </svg>
      <span class="nb-hdr-brand-text">{SITE.TITLE}</span>
    </a>

    <!-- Separator -->
    <span class="nb-hdr-sep" aria-hidden="true">|</span>

    <!-- Nav tabs (desktop) -->
    <nav class="nb-hdr-nav" aria-label="Main navigation">
      {LINKS.map((LINK) => (
        <a
          href={LINK.HREF}
          class={`nb-hdr-link${isActive(LINK.HREF) ? ' is-active' : ''}`}
        >
          {LINK.TEXT}
        </a>
      ))}
    </nav>

    <!-- Mobile hamburger -->
    <button id="header-drawer-button" class="nb-hdr-drawer-btn" aria-label="Toggle navigation drawer">
      <svg id="drawer-open" class="nb-hdr-drawer-icon">
        <use href="/ansh/ui.svg#menu"></use>
      </svg>
      <svg id="drawer-close" class="nb-hdr-drawer-icon">
        <use href="/ansh/ui.svg#x"></use>
      </svg>
    </button>

  </div>
</header>

<style>
  #header {
    background: #161b22;
    border-bottom: 1px solid #21262d;
  }

  .nb-hdr-inner {
    max-width: 1540px;
    margin: 0 auto;
    height: 100%;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
  }

  /* Brand */
  .nb-hdr-brand {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    color: #e6edf3;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.82rem;
    letter-spacing: -0.01em;
    font-weight: 600;
    flex-shrink: 0;
    transition: color 0.15s ease;
  }

  .nb-hdr-brand:hover {
    color: #3fb950;
  }

  .nb-hdr-brand-icon {
    width: 18px;
    height: 18px;
    fill: currentColor;
    flex-shrink: 0;
  }

  /* Separator */
  .nb-hdr-sep {
    color: #30363d;
    font-size: 1.1rem;
    padding: 0 0.9rem;
    user-select: none;
    flex-shrink: 0;
  }

  /* Nav tabs */
  .nb-hdr-nav {
    display: flex;
    align-items: stretch;
    height: 64px;
  }

  .nb-hdr-link {
    display: flex;
    align-items: center;
    height: 100%;
    padding: 0 0.85rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    color: #8b949e;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    border-top: 2px solid transparent; /* balance the border-bottom space */
    transition: color 0.15s ease, background 0.15s ease;
    white-space: nowrap;
  }

  .nb-hdr-link:hover {
    color: #e6edf3;
    background: rgba(255, 255, 255, 0.04);
  }

  .nb-hdr-link.is-active {
    color: #3fb950;
    border-bottom-color: #3fb950;
  }

  /* Mobile drawer button */
  .nb-hdr-drawer-btn {
    display: none;
    margin-left: auto;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    background: transparent;
    border: 1px solid #21262d;
    border-radius: 4px;
    color: #8b949e;
    cursor: pointer;
    transition: all 0.15s ease;
    flex-shrink: 0;
  }

  .nb-hdr-drawer-btn:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #e6edf3;
  }

  .nb-hdr-drawer-icon {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    fill: none;
  }

  #header-drawer-button > #drawer-open  { display: block; }
  #header-drawer-button > #drawer-close { display: none;  }
  #header-drawer-button.open > #drawer-open  { display: none;  }
  #header-drawer-button.open > #drawer-close { display: block; }

  @media (max-width: 767px) {
    .nb-hdr-nav { display: none; }
    .nb-hdr-drawer-btn { display: flex; }
  }
</style>

<script is:inline>
  function toggleDrawer() {
    const drawer = document.getElementById("drawer")
    const drawerButton = document.getElementById("header-drawer-button")
    drawer?.classList.toggle("open")
    drawerButton?.classList.toggle("open")
  }

  function initializeDrawerButton() {
    const drawerButton = document.getElementById("header-drawer-button")
    drawerButton?.addEventListener("click", toggleDrawer)
  }

  document.addEventListener("astro:after-swap", initializeDrawerButton)
  initializeDrawerButton()
</script>
